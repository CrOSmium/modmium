#!/bin/bash

# written by DMD

# -- Pre TUI init --
stty -echo 
. /usr/lib/libmosh.sh
. /usr/lib/mosh-functions.sh
[[ -d /nix ]] && mount --bind /usr/local/nix /nix

# -- MAIN SCRIPT --
tput civis # :whale:

menu_reset() {
	options=("Root Shell" "Chronos Shell" "Crosh" "Update Modmium [NOT CHROMEOS]" "Edit Device Policies" "Apps" "Misc" "Exit")
	functions=("rootsh" "chronosh" "crosh" "update" "devpol" "apps" "misc" "exit")
	num_options=${#options[@]}
}

milestone
menu_reset

selector() {
	for option in ${!options[@]}; do
		if [[ $selected_index == $option ]]; then
			${functions[$option]}
		fi
	done
}
clear
full_menu
tput cnorm
selector
